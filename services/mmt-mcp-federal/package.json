{
  "name": "mmt-mcp-federal",
  "version": "1.0.0",
  "private": true,
  "description": "MMT MCP server for federal data sources — SAM.gov, USASpending, Federal Register, Congress.gov, Grants.gov, GAO. Streamable HTTP, deployable to Fly.io.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "check": "node dist/server.js --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.45.0",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
