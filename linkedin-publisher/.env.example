# ---------------------------------------------------------------------------
# MMT LinkedIn Publisher — environment
# Copy to .env (which is gitignored) and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# PostPeer API key (Bearer token). Get it from your PostPeer dashboard after
# you connect your LinkedIn PERSONAL profile. See README "Setup".
POSTPEER_API_KEY=

# The PostPeer-side identifier for the connected LinkedIn personal profile.
# (PostPeer calls this an "account" / "channel" id — VERIFY the exact name in
# their docs. See src/postpeer.ts.)
POSTPEER_LINKEDIN_ACCOUNT_ID=

# PostPeer API base URL. Override only if PostPeer changes it.
POSTPEER_BASE_URL=https://www.postpeer.dev

# --- UTM defaults (match the FY-End campaign content) -----------------------
# The campaign links baked into the post bodies already use these values.
# utm.ts rebuilds the same URL for validation + any future tool-managed links.
UTM_BASE_URL=https://missionmeetstech.com
UTM_CAMPAIGN=fy-end-2026

# --- Direct-LinkedIn token model (ONLY if you ever bypass PostPeer) ---------
# Leave blank when using PostPeer (PostPeer manages LinkedIn OAuth on its side).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
