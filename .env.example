# Anthropic API (score-deck, gold-team-review, tactical-brief, etc.)
ANTHROPIC_API_KEY=

# Supabase (usage tracking, scoring history, contract intel, etc.)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Stripe (ProposalPulse pay-per-use checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (transactional email: score receipts, Gold Team Reviews, weekly reports)
RESEND_API_KEY=

# Perplexity (contract-intel-refresh, tactical-brief, fact-check, protest-monitor, newsletter-research)
PERPLEXITY_API_KEY=
# Touched 2026-04-18T01:12:00Z to pick up STRIPE_PRICE_FOUNDING env

# Digital Mary — Langfuse self-host (eval observability, nightly LLM-as-judge)
# DM-001 (Sprint P0-1, 2026-05-07).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://mmt-langfuse.fly.dev

# Digital Mary — Cohere Rerank 3.5 (DM-302 hybrid retrieval)
COHERE_API_KEY=

# Digital Mary — Slack notification webhook for nightly eval summary (DM-004)
EVAL_SLACK_WEBHOOK=

# Roadmap admin allowlist (Sprint C 2026-05-14). Comma-separated,
# case-insensitive email addresses authorized to use the admin paths
# of netlify/functions/roadmap-api.js. If missing/empty, the allowlist
# is empty and admin paths return 403 — that is the safe failure mode.
# Do NOT commit real operator emails to this file or to source.
ADMIN_EMAILS=admin@example.com

# ============================================================
# Government data source credentials
#
# Catalog: lib/gov-sources/registry.js
# Audit:   docs/government-api-integration-audit.md
# Status:  npm run gov:check         (registry-only, no network)
#          npm run gov:check:probe   (live HEAD/GET each base URL)
#
# Rule: never expose any of these in the browser. Every fetcher
# lives under netlify/functions/lib/ or lib/gov-sources/fetchers/
# and is server-side only.
# ============================================================

# SAM.gov — Opportunities, Entity Management, PSC, Wage Determinations,
# Assistance Listings (CFDA). Single API key works across all of these.
# Generate at: https://sam.gov  (account > Account Details > API Keys)
# ROTATION: 90 days. Daily cron `sam-key-expiration-reminder` alerts
# Mary at 30/14/7/3/1 days out and daily once expired. Update the
# `SAM_KEY_EXPIRES_UTC` constant in
# netlify/functions/sam-key-expiration-reminder.js on each rotation.
SAM_GOV_API_KEY=

# SAM.gov Contract Data system-account key (distinct from the standard
# SAM_GOV_API_KEY). Per CLAUDE.md 2026-05-07 sprint, the SAM Contract
# Data API was decommissioned 2026-02-24; this key is retained only
# in case GSA stands up a replacement system-account endpoint.
SAM_SYSTEM_ACCOUNT_API_KEY=

# Regulations.gov v4 (dockets, documents, open comment periods).
# Generate at: https://open.gsa.gov/api/regulationsgov/
# Without a real key the fetcher falls back to DEMO_KEY (tightly
# rate-limited). Premium tools depend on this for FAR/health-IT/AI
# policy monitoring; set a real key for production.
REGULATIONS_GOV_API_KEY=

# Congress.gov + GovInfo (shared key).
# Generate at: https://api.congress.gov/sign-up/  (also covers GovInfo)
# Used by signal-chain.js legislative layer and govinfo-api.js for
# Congressional reports, CFR packages, bills, hearings.
CONGRESS_API_KEY=

# USAJOBS listings (employer-side dataset only, not job-seeker auth).
# Generate at: https://developer.usajobs.gov/
# Both vars required; the user email goes in the User-Agent header
# per USAJOBS terms.
USAJOBS_API_KEY=
USAJOBS_USER_EMAIL=

# NIST National Vulnerability Database (NVD).
# OPTIONAL. Without it the fetcher works but throttles aggressively
# (~5 req per 30s window). With it, ~50.
# Generate at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# GSA Acquisition Gateway. PROBE-ONLY today. The documented v4.0
# endpoint at api.gsa.gov/acquisitiongateway/api/v4.0 returns 404
# on DEMO_KEY (last validated). Registry marks this source as
# `endpoint_unavailable` until GSA confirms the current public
# endpoint. If/when restored, this key will activate the fetcher.
GSA_API_KEY=

# Simpler.Grants.gov (newer Grants.gov API). Not currently integrated;
# slot reserved for the next sprint per the Tier-2 plan in the audit.
SIMPLER_GRANTS_API_KEY=

# Custom Deep Dive webhook (separate Stripe webhook endpoint, separate price)
STRIPE_DEEPDIVE_WEBHOOK_SECRET=whsec_xxx
STRIPE_DEEPDIVE_PRICE_ID=price_xxx
