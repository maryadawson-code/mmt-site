{
  "name": "mission-meets-tech",
  "version": "1.0.0",
  "description": "Mission Meets Tech website with auto-updating podcast episodes",
  "scripts": {
    "build": "node scripts/sync-newsletters.js; node build.js",
    "sync-newsletters": "node scripts/sync-newsletters.js",
    "test": "npx vitest run",
    "test:unit": "npx vitest run tests/unit",
    "test:smoke": "npx vitest run tests/smoke",
    "test:e2e": "npx playwright test",
    "test:links": "node scripts/validate-links.js",
    "test:integrity": "node scripts/verify-integrity.js",
    "verify": "node build.js && node scripts/verify-integrity.js && npx vitest run tests/unit && npx playwright test",
    "lighthouse": "npx @lhci/cli autorun",
    "smoke": "bash scripts/smoke-test.sh",
    "dev": "npx netlify dev"
  },
  "dependencies": {
    "@sentry/node": "^9.0.0",
    "@supabase/supabase-js": "^2.100.1",
    "bcryptjs": "^3.0.3",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.8.0",
    "marked": "^17.0.5",
    "officeparser": "^6.0.7",
    "pdf-parse": "~1.1.1",
    "pdfkit": "^0.17.2",
    "rss-parser": "^3.13.0",
    "sharp": "^0.34.5",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "tailwindcss": "~3.4.19",
    "vitest": "^4.1.0"
  }
}
