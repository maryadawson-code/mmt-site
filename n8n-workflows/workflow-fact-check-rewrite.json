{
  "name": "MMT Fact-Check + Rewrite",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "fact-check-rewrite",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "fact-check-rewrite"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst content = body.content;\nconst context = body.context || '';\n\nif (!content || typeof content !== 'string') {\n  return [{ json: { error: 'content is required', valid: false } }];\n}\n\nif (content.length > 10000) {\n  return [{ json: { error: 'content exceeds 10,000 character limit', valid: false } }];\n}\n\nreturn [{ json: { content, context, valid: true } }];"
      },
      "id": "validate",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "is-valid",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "check-valid",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://missionmeetstech.com/.netlify/functions/fact-check",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ content: $node['Validate Input'].json.content, context: $node['Validate Input'].json.context }) }}",
        "options": {
          "response": { "response": { "responseFormat": "json" } },
          "timeout": 90000,
          "retry": { "maxTries": 1, "retryIntervalMs": 2000 }
        }
      },
      "id": "fact-check",
      "name": "Netlify Fact-Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "anthropic-version", "value": "2023-06-01" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-20250514', max_tokens: 4000, system: 'You are an editor for Mission Meets Tech. Given the original text and fact-check results, rewrite only the claims that were flagged as incorrect, outdated, or partially_correct. Preserve the original voice and structure exactly. Mark each change with [CORRECTED] inline. If all claims are verified, return the original text unchanged with a note that no corrections were needed. Return the corrected text only, no JSON wrapper.', messages: [{ role: 'user', content: 'ORIGINAL TEXT:\\n' + $node['Validate Input'].json.content + '\\n\\nFACT-CHECK RESULTS:\\n' + JSON.stringify($node['Netlify Fact-Check'].json) + '\\n\\nRewrite with corrections where needed.' }] }) }}",
        "options": {
          "response": { "response": { "responseFormat": "json" } },
          "timeout": 60000,
          "retry": { "maxTries": 1, "retryIntervalMs": 2000 }
        }
      },
      "id": "claude-rewrite",
      "name": "Claude Rewrite",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, -100],
      "credentials": {
        "httpHeaderAuth": { "id": "ANTHROPIC_CRED_ID", "name": "Anthropic API" }
      }
    },
    {
      "parameters": {
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        },
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ original_content: $node['Validate Input'].json.content, fact_check: $node['Netlify Fact-Check'].json, corrected_content: $node['Claude Rewrite'].json.content[0].text, overall_accuracy: $node['Netlify Fact-Check'].json.overall_accuracy }) }}"
      },
      "id": "respond-success",
      "name": "Return Results",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, -100]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 400,
          "responseHeaders": {
            "entries": [
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        },
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ error: $json.error }) }}"
      },
      "id": "respond-error",
      "name": "Return Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [660, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'MMT Intel <noreply@missionmeetstech.com>', to: ['mary@missionmeetstech.com'], subject: 'n8n Error: Fact-Check + Rewrite', html: '<p>The Fact-Check + Rewrite workflow encountered an error:</p><pre>' + JSON.stringify($json, null, 2) + '</pre>' }) }}",
        "options": {}
      },
      "id": "error-email",
      "name": "Error Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "credentials": {
        "httpHeaderAuth": { "id": "RESEND_CRED_ID", "name": "Resend API" }
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Validate Input", "type": "main", "index": 0 }]] },
    "Validate Input": { "main": [[{ "node": "Valid?", "type": "main", "index": 0 }]] },
    "Valid?": { "main": [[{ "node": "Netlify Fact-Check", "type": "main", "index": 0 }], [{ "node": "Return Error", "type": "main", "index": 0 }]] },
    "Netlify Fact-Check": { "main": [[{ "node": "Claude Rewrite", "type": "main", "index": 0 }]] },
    "Claude Rewrite": { "main": [[{ "node": "Return Results", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "errorWorkflow": "error-email",
    "timezone": "America/New_York",
    "saveManualExecutions": true
  },
  "tags": [{ "name": "mmt-intelligence" }]
}
