{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://missionmeetstech.com/docs/newsletter-production-payload.schema.json",
  "title": "MMT Newsletter Production Payload",
  "description": "Payload Mary's Claude Project produces when she says `send to production`. The publish-newsletter.js script validates against this schema, writes a frontmatter-prefixed markdown file under content/newsletter/, and triggers the GitHub Actions workflow that opens a PR (or, with explicit approval, lands directly on main).",
  "type": "object",
  "required": ["title", "description", "body_markdown", "publish_date", "status", "approval_phrase", "visibility"],
  "additionalProperties": false,
  "properties": {
    "title":            { "type": "string", "minLength": 5, "maxLength": 200 },
    "dek":              { "type": "string", "maxLength": 280 },
    "description":      { "type": "string", "minLength": 20, "maxLength": 320, "description": "Excerpt / SEO description. 1–2 sentences." },
    "body_markdown":    { "type": "string", "minLength": 200, "description": "Full body of the newsletter, GitHub-flavored Markdown. Frontmatter delimiters are added by the publisher — do NOT include `---` blocks." },
    "publish_date":     { "type": "string", "format": "date", "description": "YYYY-MM-DD." },
    "issue_number":     { "type": "integer", "minimum": 1 },
    "slug":             { "type": "string", "pattern": "^[a-z0-9](?:-?[a-z0-9])*$", "description": "Optional. If absent, derived from title." },
    "author":           { "type": "string", "default": "Mary Womack" },
    "status":           { "type": "string", "enum": ["draft", "production_approved"], "description": "Hard gate: only `production_approved` triggers the publish flow." },
    "approval_phrase":  { "type": "string", "enum": ["send_to_production"] },
    "visibility":       { "type": "string", "enum": ["public", "premium", "founding"], "default": "public" },
    "topics":           { "type": "array", "items": { "type": "string" }, "default": [] },
    "tags":             { "type": "array", "items": { "type": "string" }, "default": [] },
    "canonical_category": { "type": "string", "enum": ["analysis", "deep-dive", "rapid-response", "field-notes", "explainer"] },
    "social_title":     { "type": "string", "maxLength": 90 },
    "seo_title":        { "type": "string", "maxLength": 70 },
    "meta_description": { "type": "string", "maxLength": 160 },
    "source_links":     { "type": "array", "items": { "type": "string", "format": "uri" } },
    "related_contracts":{ "type": "array", "items": { "type": "string" } },
    "related_agencies": { "type": "array", "items": { "type": "string" } },
    "podcast_episode":  { "type": "string" },
    "capture_corner_teaser": { "type": "string", "maxLength": 320 },
    "capture_corner":   { "type": "array", "items": { "type": "string", "minLength": 30 }, "description": "List of 2–5 capture-intel paragraphs. Each is a string (not an object) to match existing newsletter schema." },
    "capture_window":   { "type": "string", "maxLength": 80 },
    "confidence_label": { "type": "string", "enum": ["FACT", "Inferred", "MMT Analysis"] },
    "premium_notes":    { "type": "array", "items": { "type": "string" } },
    "linkedin_drafts":  { "type": "array", "items": { "type": "string" } },
    "send_email":       { "type": "boolean", "default": false, "description": "Email send is a SEPARATE manual step. The publisher will not send unless Mary separately uses the phrase `send email newsletter`." },
    "publish_mode":     { "type": "string", "enum": ["pr", "direct_to_main"], "default": "pr" },
    "direct_to_main_acknowledgement": { "type": "string", "description": "Required only when publish_mode=direct_to_main. Must read: `I authorize direct main publish for this issue`." }
  }
}
