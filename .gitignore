# Dependencies
node_modules/

# Build output (Netlify generates this)
dist/

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Large media files
*.mp4
*.zip

# Environment files
.env
.env.local
.env.*.local
.env.production
.env.*
!.env.example
# Logs
*.log
npm-debug.log*

# Local Netlify folder
.netlify

# Supabase CLI local state
supabase/.temp/

# Sentinel monitoring logs (local only)
.sentinel/

# SEO agent local logs (knowledge base is version-controlled — logs are not)
.seo-agent/
.claude/worktrees/
# demos/ removed — the production iframe demo assets (proposal-pulse-demo.html,
# compliance-check-demo-0{1,2,3}.html) are linked from /proposal-pulse and
# /premium/compliance-check and must ship to production.
output/
test-results/
n8n-workflows/
deno.lock

# Ops health rollup is regenerated on every build; not committed.
ops/

# Private/server-only PII files. Per Sprint A (2026-05-13) PII scrub,
# anything under private/ MUST stay off the public repo tip. This
# directory exists for files like fy2027-backfill-list.csv that the
# local backfill script reads but that contain customer emails.
private/

# Editor / one-shot backup artifacts. Per Sprint B (2026-05-13), we
# caught netlify/functions/agent-bridge.js.backup in tip-of-tree —
# this rule prevents the same regression class.
*.backup
*.bak

# Root sitemap.xml is build-generated into dist/sitemap.xml by
# build.js (line ~852). The root copy that used to live here was
# stale (last updated 2026-03-03) and unreferenced. Per Sprint B
# (2026-05-13), keep root sitemap.xml out of tip-of-tree so editor
# auto-saves or build artifacts can't re-introduce a stale copy.
/sitemap.xml
