{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Netlify Dev Server",
      "runtimeExecutable": "/usr/local/bin/node",
      "runtimeArgs": ["-e", "const h=require('http'),f=require('fs'),p=require('path'),m={'html':'text/html','css':'text/css','js':'application/javascript','json':'application/json','png':'image/png','jpg':'image/jpeg','svg':'image/svg+xml','xml':'application/xml','ico':'image/x-icon','woff2':'font/woff2','woff':'font/woff','ttf':'font/ttf','mp3':'audio/mpeg','mp4':'video/mp4','pdf':'application/pdf'};h.createServer((q,r)=>{let u=q.url.split('?')[0];if(u.endsWith('/'))u+='index.html';const d=p.join('dist',u),e=p.extname(d).slice(1);if(f.existsSync(d)&&f.statSync(d).isFile()){r.writeHead(200,{'Content-Type':m[e]||'application/octet-stream'});f.createReadStream(d).pipe(r)}else if(f.existsSync(d)&&f.statSync(d).isDirectory()&&f.existsSync(p.join(d,'index.html'))){r.writeHead(200,{'Content-Type':'text/html'});f.createReadStream(p.join(d,'index.html')).pipe(r)}else{r.writeHead(404,{'Content-Type':'text/html'});const n=p.join('dist','404.html');f.existsSync(n)?f.createReadStream(n).pipe(r):r.end('Not Found')}}).listen(8888,()=>console.log('Serving dist/ on http://localhost:8888'))"],
      "port": 8888
    }
  ]
}
